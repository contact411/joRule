---
import CopyCommand from './CopyCommand'
import { INSTALL_COMMAND, INSTALL_URL, REPO_URL } from '../../lib/site'

const steps = [
  {
    snum: '01',
    title: 'Detect',
    body: 'jaRules reads your platform and existing tools, then decides what to install and what to leave alone.',
  },
  {
    snum: '02',
    title: 'Install',
    body: 'Rules, prompts, and MCP setup land where each tool expects them. Shell, git, and node configs are opt-in extras.',
  },
  {
    snum: '03',
    title: 'Work',
    body: "Open your editor. Every agent you run starts from your standard, and one sync keeps it that way.",
  },
]
---

<section id="install" class="section">
  <div class="container relative">
    <span class="ghost" aria-hidden="true">04</span>

    <div class="mx-auto max-w-[720px] text-center">
      <div class="sec-head justify-center">
        <p class="overline">Install</p>
        <span class="folio" aria-hidden="true">04 / 04</span>
      </div>

      <h2 class="text-balance">
        Your agents, to your standard, <em>in one command.</em>
      </h2>
      <p class="mx-auto max-w-[44ch] text-muted-foreground">
        Copy the line. Run it. Open your editor. Everything else is handled.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3.5">
        <a
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md px-5 text-sm font-semibold text-background transition-colors bg-foreground hover:bg-foreground/90"
          href={INSTALL_URL}
        >
          Install jaRules<span aria-hidden="true">→</span>
        </a>
        <a
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-border px-5 text-sm font-semibold text-foreground transition-colors hover:border-primary hover:text-primary"
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the rules
        </a>
      </div>

      <div class="mt-10 text-left">
        <CopyCommand command={INSTALL_COMMAND} client:load />
      </div>

      <div class="mt-12 grid grid-cols-1 gap-[18px] text-left md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="border-t-2 border-border pt-5">
              <p class="mb-3.5 inline-flex items-center gap-2.5 font-mono text-[11px] tracking-[0.18em] text-foreground/55">
                {step.snum}
                <span class="h-[5px] w-[5px] flex-none bg-primary" aria-hidden="true"></span>
              </p>
              <h3 class="mb-2 text-base">{step.title}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{step.body}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-sm text-muted-foreground">
        Prefer to browse first?{' '}
        <a
          class="border-b border-border text-primary transition-colors hover:border-foreground hover:text-foreground"
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the rules on GitHub
        </a>
        .
      </p>
    </div>
  </div>
</section>