---
// The three canonical feature cards (copy.md v1, verbatim).
const cards = [
  {
    fnum: '01',
    kicker: 'one standard',
    title: 'One standard, four tools',
    body: 'Write rules once. Cursor, Claude Code, Cline, and Roo all read the same base rules, with tool-specific overrides only where they genuinely differ.',
    span: 'lg:col-span-4',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 20 6 12 10 4 6z"/><path d="M4 12 12 16 20 12"/><path d="M4 18 12 22 20 18"/></svg>',
  },
  {
    fnum: '02',
    kicker: 'foundation · common',
    title: 'Prompt library',
    body: 'Foundations, PRDs, review checklists, debugging loops. Start from a template that encodes the shape of good work.',
    span: 'lg:col-span-2',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6c-1.9-1.3-4.1-2-6.5-2H2v15h3.5c2.4 0 4.6.7 6.5 2 1.9-1.3 4.1-2 6.5-2H22V4h-3.5c-2.4 0-4.6.7-6.5 2z"/><path d="M12 6v15"/></svg>',
  },
  {
    fnum: '03',
    kicker: 'mcp servers',
    title: 'MCP servers wired in',
    body: 'Filesystem, git, and project-aware MCP servers land configured, not an afternoon of YAML. Your agent has context from the first turn.',
    span: 'lg:col-span-6',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 8v4l2.5 2.5"/></svg>',
  },
]
---

<section id="rules" class="section">
  <div class="container relative">
    <span class="ghost" aria-hidden="true">01</span>

    <div class="sec-head">
      <p class="overline">The rules</p>
      <span class="sec-rule" aria-hidden="true"></span>
      <span class="folio" aria-hidden="true">01 / 04</span>
    </div>

    <h2 class="max-w-[22ch]">What your agents get from day one</h2>
    <p class="max-w-[60ch] text-muted-foreground">
      One repo, one standard, and nothing to assemble. Each piece below lives in plain files you
      can read, diff, and fork.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-[18px] lg:grid-cols-6">
      {
        cards.map((card) => (
          <article
            class:list={[
              'group flex flex-col gap-5 rounded-xl border border-border bg-card p-7 transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-primary hover:shadow-soft',
              card.span,
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <span
                class="grid h-12 w-12 flex-none place-items-center rounded-md border border-border text-muted-foreground transition-colors duration-200 group-hover:border-primary group-hover:text-primary"
                aria-hidden="true"
                set:html={card.icon}
              ></span>
              <span class="inline-flex items-center gap-2 font-mono text-[10.5px] tracking-[0.18em] text-foreground/55">
                <span class="h-px w-3 bg-primary" aria-hidden="true"></span>
                {card.fnum}
              </span>
            </div>
            <div>
              <p class="mb-3 inline-flex items-center gap-2 font-mono text-[10.5px] uppercase italic tracking-[0.18em] text-muted-foreground">
                <span class="h-[5px] w-[5px] flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
                {card.kicker}
              </p>
              <h3 class="mb-2">{card.title}</h3>
              <p class="max-w-[52ch] text-[15px] leading-relaxed text-muted-foreground">{card.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>