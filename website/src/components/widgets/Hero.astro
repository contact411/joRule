---
// jaRules lander — Hero. Copy is canonical (copy.md v1); the
// terminal transcript and commit grammar mirror the approved v5 concept.
import { INSTALL_COMMAND, REPO_URL, BRAND, SITE_DOMAIN } from '../../lib/site'

const tools = ['Cursor', 'Claude Code', 'Cline', 'Roo']
---

<section id="top" class="hero">
  <div class="hero-rule" aria-hidden="true"></div>
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="container relative">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="hero-copy lg:col-span-7">
        <div class="sec-head">
          <p class="overline">AI rules, versioned like code</p>
          <span class="sec-rule" aria-hidden="true"></span>
          <span class="folio" aria-hidden="true">{BRAND} · {SITE_DOMAIN}</span>
        </div>

        <h1 class="mb-6">
          Every agent works to <em>your standard.</em>
        </h1>

        <p class="lead mb-8 max-w-[60ch] text-lg text-muted-foreground">
          A versioned repo of AI rules and prompts for Cursor, Claude Code, Cline, and Roo. One
          command installs everything.
        </p>

        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-4">
          <code class="cmd-chip"><span class="d">$</span> {INSTALL_COMMAND}</code>

          <div class="flex flex-col gap-2 font-mono text-[13px] leading-[1.7]">
            <code class="text-muted-foreground"><span class="text-foreground/55">$</span> ./install.sh --rules-only</code>
            <code class="text-muted-foreground"><span class="text-foreground/55">$</span> ./install.sh --dotfiles-only</code>
          </div>

          <a
            class="inline-flex h-10 items-center gap-2 rounded-md border border-border px-5 text-sm font-semibold text-foreground transition-colors hover:border-primary hover:text-primary"
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the rules<span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="mt-6 font-mono text-xs tracking-[0.03em] text-foreground/55">
          macOS · Linux · Windows — safe to re-run, zero hardcoded secrets
        </p>

        <div class="mt-6 flex flex-wrap gap-2" aria-label="Supported tools">
          {tools.map((tool) => (
            <span
              class="inline-flex items-center gap-[7px] rounded-full border border-border px-[13px] py-2 font-mono text-xs uppercase tracking-[0.08em]"
            >
              <span class="h-[5px] w-[5px] flex-none rounded-full bg-primary" aria-hidden="true"></span>
              {tool}
            </span>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5">
        <div
          class="terminal relative overflow-hidden rounded-xl border border-border bg-background shadow-lift"
          role="img"
          aria-label="Illustrative jaRules install transcript in a terminal window"
        >
          <div class="flex items-center gap-2 border-b border-border bg-card px-4 py-3">
            <span class="h-[11px] w-[11px] rounded-full bg-destructive" aria-hidden="true"></span>
            <span class="h-[11px] w-[11px] rounded-full bg-destructive" aria-hidden="true"></span>
            <span class="h-[11px] w-[11px] rounded-full bg-primary" aria-hidden="true"></span>
            <span class="ml-2.5 font-mono text-xs tracking-[0.04em] text-muted-foreground">
              install.sh · <b class="font-semibold text-muted-foreground">zsh</b>
            </span>
          </div>

          <div class="terminal-shell overflow-x-auto p-5 font-mono text-[13px] leading-[1.85]">
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">01</span>
              <span><span class="text-primary">$ </span><span class="t-cmd">{INSTALL_COMMAND}</span></span>
            </div>
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">02</span>
              <span><span class="t-sub">→ </span><span class="t-sub">platform detected: macOS (arm64)</span></span>
            </div>
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">03</span>
              <span>
                <span class="t-sub">→ </span><span class="t-sub">rules ready for: </span
                ><span class="t-accent">claude-code · cursor · cline · roo</span>
              </span>
            </div>
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">04</span>
              <span>
                <span class="t-sub">→ </span><span class="t-sub">prompt library: </span
                ><span class="t-accent">foundation · prd · review · debug</span>
              </span>
            </div>
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">05</span>
              <span>
                <span class="t-sub">→ </span><span class="t-sub">mcp servers: </span
                ><span class="t-accent">filesystem · git · project-aware</span>
              </span>
            </div>
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">06</span>
              <span>
                <span class="t-sub">→ </span><span class="t-sub">shell &amp; git configs (</span
                ><span class="t-dim">opt-in</span><span class="t-sub">)</span>
              </span>
            </div>
            <div class="grid grid-cols-[30px_1fr] whitespace-nowrap">
              <span class="select-none pr-3.5 text-right text-[10.5px] text-foreground/25" aria-hidden="true">07</span>
              <span>
                <span class="t-accent">✓ </span><span class="t-cmd">your agents now work the way you do<span class="caret"></span></span>
              </span>
            </div>
          </div>
        </div>

        <p class="mt-3.5 text-center font-mono text-[11px] tracking-[0.04em] text-foreground/55">
          Illustrative transcript — actual output varies by machine
        </p>
      </div>
    </div>
  </div>
</section>