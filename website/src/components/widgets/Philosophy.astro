---
// Section rhythm and stance text mirror the approved v5 concept verbatim.
const principles = [
  {
    pnum: '01',
    title: 'Decide once',
    body: "You don't pick a linter, a prompt style, or a signing key every morning. jaRules makes the choice once, and every agent you run inherits it.",
  },
  {
    pnum: '02',
    title: 'Idempotent by design',
    body: "Re-run the installer any time. It detects what you already have and adds only what's missing, so a broken setup never means starting over.",
  },
  {
    pnum: '03',
    title: 'No secrets in files',
    body: "Template-based configs and keychain-backed credentials. The repo holds zero hardcoded secrets, so it's safe to share and safe to fork.",
  },
]
---

<section id="build" class="section">
  <div class="container relative">
    <span class="ghost" aria-hidden="true">02</span>

    <div class="sec-head">
      <p class="overline">How it's built</p>
      <span class="sec-rule" aria-hidden="true"></span>
      <span class="folio" aria-hidden="true">02 / 04</span>
    </div>

    <h2>Opinions are <em>features</em>.</h2>
    <p class="max-w-[56ch] text-muted-foreground">
      jaRules is opinionated on purpose. Fewer decisions every morning, the same standard
      everywhere you work, and configs you can trust on a bad day.
    </p>

    <div class="mt-16 grid grid-cols-1 gap-[18px] md:grid-cols-3">
      {
        principles.map((principle) => (
          <div class="border-t-2 border-border pt-[22px]">
            <p class="mb-4 inline-flex items-center gap-2.5 font-mono text-[10.5px] tracking-[0.18em] text-foreground/55">
              {principle.pnum}
              <span class="h-[5px] w-[5px] flex-none bg-primary" aria-hidden="true"></span>
            </p>
            <h3 class="mb-2.5">{principle.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted-foreground">{principle.body}</p>
          </div>
        ))
      }
    </div>

    <div class="pull">
      <blockquote>Your best work should be the default.</blockquote>
      <p class="attr">— the jaRules stance on setup</p>
    </div>
  </div>
</section>