---
// Scenario titles/bodies/commands are copy.md v1 VERBATIM.
// The repo-map aside and stance line mirror the approved v5 concept.
import { REPO_URL } from '../../lib/site'

const scenarios = [
  {
    snum: '01',
    title: 'Open a project',
    body: 'New repo? jaRules reads package.json and requirements.txt, then applies the matching rules and prompts. Your agent starts with context, not a blank slate.',
    command: './jarule ai-init --tool=claude-code --type=web-app',
  },
  {
    snum: '02',
    title: 'Ask for a PRD',
    body: "The prompt library hands you the requirements template: scope, acceptance criteria, review checklist. You fill it in, you don't invent the shape of it.",
    command: './jarule prompts --add=foundational-requirements',
  },
  {
    snum: '03',
    title: 'Keep it current',
    body: 'Standards drift in settings panels. One sync command reapplies your rules, so the version you reviewed is the version your agents run.',
    command: './jarule ai-sync',
  },
]
---

<section id="practice" class="section">
  <div class="container relative">
    <span class="ghost" aria-hidden="true">03</span>

    <div class="sec-head">
      <p class="overline">In practice</p>
      <span class="sec-rule" aria-hidden="true"></span>
      <span class="folio" aria-hidden="true">03 / 04</span>
    </div>

    <h2 class="max-w-[22ch]">See the <em>standard</em> in action</h2>

    <div class="mt-12 grid grid-cols-1 items-start gap-14 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        {
          scenarios.map((scenario) => (
            <div class="border-t border-border py-[30px] last:border-b">
              <div class="mb-2.5 flex items-baseline gap-[18px]">
                <span class="font-mono text-[11px] tracking-[0.18em] text-foreground/55">
                  {scenario.snum}
                </span>
                <h3 class="text-[20px]">{scenario.title}</h3>
              </div>
              <p class="mb-4 max-w-[52ch] text-[15.5px] leading-relaxed text-muted-foreground">
                {scenario.body}
              </p>
              <code class="cmd-chip"><span class="d">$</span> {scenario.command}</code>
            </div>
          ))
        }
      </div>

      <aside class="rounded-xl border border-border bg-background p-[26px] shadow-soft lg:sticky lg:top-[84px]">
        <div class="mb-5 flex items-baseline justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          <span>What's inside</span>
          <span class="inline-flex items-center gap-2 text-foreground/55">
            <span class="h-[5px] w-[5px] bg-primary" aria-hidden="true"></span>
            repo map
          </span>
        </div>
        <pre class="tree overflow-x-auto font-mono text-[13px] leading-[1.95] text-foreground">ai-rules/
  <span class="text-foreground/55">templates/</span>      <span class="text-foreground">base + tool-specific</span>
  <span class="text-foreground/55">prompt-library/</span> <span class="text-foreground">foundation · prd · review · debug</span>
  <span class="text-foreground/55">mcp-servers/</span>    <span class="text-foreground">project-aware configs</span>
config/<span class="text-foreground/55">  git · npm · shells · starship · vscode</span>
scripts/<span class="text-foreground/55">  installers · idempotent, guarded</span>
install.sh<span class="text-foreground/55">  entry point</span></pre>
      </aside>
    </div>

    <div class="mt-20 text-center">
      <p class="mx-auto max-w-[30ch] font-serif text-[24px] font-bold italic leading-[1.28] tracking-tight md:text-[32px]">
        Your agents should learn your standards, not guess them.
      </p>
      <a
        class="mt-6 inline-block border-b border-border pb-0.5 text-sm font-semibold text-primary transition-colors hover:border-foreground hover:text-foreground"
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Open source. Read the rules on GitHub →
      </a>
    </div>
  </div>
</section>