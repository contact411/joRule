---
import '../styles/globals.css'
import { BRAND, DEFAULT_TITLE, DEFAULT_DESCRIPTION, SITE_URL, SITE_DOMAIN } from '../lib/site'

export interface Props {
  metadata?: {
    title?: string
    description?: string
    canonical?: string
  }
}

const {
  metadata = {
    title: DEFAULT_TITLE,
    description: DEFAULT_DESCRIPTION,
    canonical: SITE_URL,
  },
} = Astro.props

const { title, description, canonical } = metadata
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#2C3E50" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="antialiased">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-sm">
      <nav class="container relative flex h-16 items-center gap-8" aria-label="Primary">
        <input
          type="checkbox"
          id="nav-toggle"
          class="peer absolute -ml-px -mt-px h-px w-px opacity-0 pointer-events-none"
          aria-label="Toggle menu"
        />

        <a href="#top" class="inline-flex items-center gap-[11px] font-serif text-[19px] font-bold tracking-tight">
          <span class="block h-[9px] w-[9px] flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
          {BRAND}
        </a>

        <ul class="hidden items-center gap-7 lg:ml-auto lg:flex">
          <li><a class="nav-link" href="#rules">The rules</a></li>
          <li><a class="nav-link" href="#build">How it's built</a></li>
          <li><a class="nav-link" href="#practice">In practice</a></li>
          <li><a class="nav-link" href="#install">Install</a></li>
        </ul>

        <a
          class="hidden h-9 items-center justify-center gap-2 rounded-md border border-transparent px-4 text-sm font-semibold text-background transition-colors bg-foreground hover:bg-foreground/90 lg:ml-9 lg:inline-flex"
          href="#install"
        >
          Install<span aria-hidden="true">→</span>
        </a>

        <!-- Mobile: checkbox-driven burger + panel (no JS required) -->
        <label
          for="nav-toggle"
          class="ml-auto flex h-10 w-10 cursor-pointer flex-col items-center justify-center gap-[5px] rounded-md p-2 lg:hidden peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring
                 peer-checked:[&>span:first-child]:translate-y-[7px] peer-checked:[&>span:first-child]:rotate-45
                 peer-checked:[&>span:nth-child(2)]:opacity-0
                 peer-checked:[&>span:last-child]:-translate-y-[7px] peer-checked:[&>span:last-child]:-rotate-45"
          aria-hidden="true"
        >
          <span class="block h-[2px] w-full rounded-[2px] bg-foreground transition-transform duration-200"></span>
          <span class="block h-[2px] w-full rounded-[2px] bg-foreground transition-opacity duration-200"></span>
          <span class="block h-[2px] w-full rounded-[2px] bg-foreground transition-transform duration-200"></span>
        </label>

        <div class="absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-border bg-card p-4 pb-6 shadow-soft peer-checked:flex lg:hidden">
          <ul class="flex flex-col">
            <li><a class="mobile-link" href="#rules">The rules</a></li>
            <li><a class="mobile-link" href="#build">How it's built</a></li>
            <li><a class="mobile-link" href="#practice">In practice</a></li>
            <li><a class="mobile-link" href="#install">Install</a></li>
          </ul>
          <a class="mt-4 inline-flex h-10 items-center justify-center gap-2 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground hover:bg-primary/90" href="#install">
            Install {BRAND}
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-border bg-card">
      <div class="container flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
        <div class="max-w-[26ch]">
          <a href="#top" class="inline-flex items-center gap-[11px] font-serif text-lg font-bold tracking-tight">
            <span class="block h-[9px] w-[9px] flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
            {BRAND}
          </a>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            Versioned AI rules for agent-first work.
          </p>
        </div>

        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-6 gap-y-3">
            <li><a class="footer-link" href="#rules">The rules</a></li>
            <li><a class="footer-link" href="#practice">In practice</a></li>
            <li><a class="footer-link" href="#install">Install</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-border">
        <div class="container flex flex-wrap items-center justify-between gap-y-2 py-6 text-xs text-muted-foreground/80">
          <span>© 2026 {BRAND} · {SITE_DOMAIN}</span>
          <span class="font-mono">open source — fork it, send a PR</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Progressive enhancement only — the page works without JS.
      // Closes the checkbox-driven mobile menu after choosing a destination.
      (function () {
        try {
          if (typeof window === 'undefined' || !document) return
          var toggle = document.getElementById('nav-toggle')
          if (toggle) {
            var links = toggle.parentNode ? toggle.parentNode.querySelectorAll('.mobile-link, .footer-link, .nav-link') : []
            for (var i = 0; i < links.length; i++) {
              links[i].addEventListener('click', function () {
                toggle.checked = false
              })
            }
          }
        } catch (e) {
          /* never break the page */
        }
      })()
    </script>
  </body>
</html>