---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/widgets/Hero.astro'
import Features from '../components/widgets/Features.astro'
import Philosophy from '../components/widgets/Philosophy.astro'
import Showcase from '../components/widgets/Showcase.astro'
import CTA from '../components/widgets/CTA.astro'
import { DEFAULT_TITLE, DEFAULT_DESCRIPTION, SITE_URL } from '../lib/site'

const metadata = {
  title: DEFAULT_TITLE,
  description: DEFAULT_DESCRIPTION,
  canonical: SITE_URL,
}
---

<Layout metadata={metadata}>
  <Hero />
  <Features />
  <Philosophy />
  <Showcase />
  <CTA />
</Layout>